{
	"name": "bg3-osiris",
	"displayName": "BG3 Osiris",
	"description": "",
	"version": "0.0.1",
	"engines": {
		"vscode": "^1.103.0"
	},
	"publisher": "SASUKE38",
	"repository": {
		"type": "git",
		"url": "https://github.com/SASUKE38/bg3-osiris"
	},
	"categories": [
		"Programming Languages",
		"Snippets"
	],
	"activationEvents": [
		"workspaceContains:meta.lsx"
	],
	"main": "./dist/client/src/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "bg3Osiris.RefreshStoryTree",
				"title": "Refresh Story Tree",
				"icon": "$(refresh)"
			},
			{
				"command": "bg3Osiris.AddGoal",
				"title": "Add Goal",
				"icon": "$(add)"
			},
			{
				"command": "bg3Osiris.OverrideGoal",
				"title": "Override",
				"icon": "$(pencil)"
			},
			{
				"command": "bg3Osiris.DeleteGoal",
				"title": "Delete"
			},
			{
				"command": "bg3Osiris.RenameGoal",
				"title": "Rename"
			}
		],
		"languages": [
			{
				"id": "osiris",
				"aliases": [
					"Osiris",
					"osiris"
				],
				"extensions": [
					".txt"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "bg3Osiris.AddGoal",
					"when": "false"
				},
				{
					"command": "bg3Osiris.OverrideGoal",
					"when": "false"
				},
				{
					"command": "bg3Osiris.DeleteGoal",
					"when": "false"
				},
				{
					"command": "bg3Osiris.RenameGoal",
					"when": "false"
				}
			],
			"view/title": [
				{
					"command": "bg3Osiris.RefreshStoryTree",
					"when": "view == story-outline",
					"group": "navigation"
				}
			],
			"view/item/context": [
				{
					"command": "bg3Osiris.AddGoal",
					"when": "view == story-outline",
					"group": "inline"
				},
				{
					"command": "bg3Osiris.OverrideGoal",
					"when": "view == story-outline && viewItem == inherited",
					"group": "inline"
				},
				{
					"command": "bg3Osiris.DeleteGoal",
					"when": "view == story-outline && viewItem == overriden"
				},
				{
					"command": "bg3Osiris.RenameGoal",
					"when": "view == story-outline && viewItem == overriden"
				}
			]
		},
		"grammars": [
			{
				"language": "osiris",
				"scopeName": "source.osiris",
				"path": "./syntaxes/osiris.tmLanguage.json"
			}
		],
		"snippets": [
			{
				"language": "osiris",
				"path": "./syntaxes/osiris.tmSnippet.json"
			}
		],
		"themes": [
			{
				"id": "osirisDark.theme",
				"label": "Osiris Dark",
				"path": "./syntaxes/osirisDark.tmTheme.json",
				"uiTheme": "vs-dark"
			},
			{
				"id": "osirisLight.theme",
				"label": "Osiris Light",
				"path": "./syntaxes/osirisLight.tmTheme.json",
				"uiTheme": "vs"
			}
		],
		"semanticTokenTypes": [
			{
				"id": "osiris_builtin",
				"superType": "function",
				"description": "A built in Osiris procedure, query, or event."
			},
			{
				"id": "call",
				"superType": "osiris_builtin",
				"description": "An osiris PROC."
			},
			{
				"id": "query",
				"superType": "osiris_builtin",
				"description": "An osiris QRY."
			},
			{
				"id": "event",
				"superType": "osiris_builtin",
				"description": "An osiris event."
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "story-outline",
					"title": "Story Outline",
					"icon": "./media/dep.svg"
				}
			]
		},
		"views": {
			"story-outline": [
				{
					"id": "story-outline",
					"name": "Story Outline",
					"icon": "./media/dep.svg"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "story-outline",
				"contents": "No story items found."
			}
		],
		"configuration": {
			"type": "object",
			"title": "BG3 Osiris",
			"properties": {
				"bg3Osiris.dependencyPaths": {
					"scope": "machine",
					"type": "array",
					"markdownDescription": "Directories to search in when looking for `.pak` files for mod dependencies. For example, the `.../Baldurs Gate 3/Data`.",
					"items": {
						"type": "string",
						"title": "Path"
					}
				},
				"bg3Osiris.baseMods.game": {
					"type": "string",
					"markdownDescription": "Mods to always load regardless of the dependencies listed in a mod's metadata. Prebundled game-specific libraries currently only include Baldur's Gate 3.",
					"enum": [
						"Baldur's Gate 3",
						"Custom Only",
						"None"
					],
					"markdownEnumDescriptions": [
						"Baldur's Gate 3 base mods. Includes Shared, SharedDev, Gustav, and GustavDev.",
						"Only load the mods in `#bg3Osiris.baseMods.customPaths#`.",
						"Load no base mods. Only the mods in the mod's dependency list will be loaded."
					],
					"default": "Baldur's Gate 3"
				},
				"bg3Osiris.baseMods.customPaths": {
					"type": "array",
					"markdownDescription": "Paths to `.pak` files to always load regardless of a mod's dependencies. Will be loaded in addition to the selection in `#bg3Osiris.baseMods.game#` unless None is chosen.",
					"items": {
						"type": "string"
					}
				}
			}
		}
	},
	"scripts": {
		"lint": "eslint",
		"postinstall": "cd client && npm install && cd ../server && npm install && cd ..",
		"test": "sh ./scripts/e2e.sh",
		"compile": "npm run check-types && node esbuild.js",
		"check-types": "tsc --noEmit",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.js --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"vscode:prepublish": "npm run package",
		"package": "npm run check-types && node esbuild.js --production"
	},
	"devDependencies": {
		"@eslint/js": "^9.38.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/mocha": "^10.0.6",
		"@types/node": "^22",
		"esbuild": "^0.28.2",
		"esbuild-plugin-copy": "^2.1.1",
		"eslint": "^9.38.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^16.4.0",
		"jiti": "^2.6.1",
		"mocha": "^10.3.0",
		"npm-run-all": "^4.1.5",
		"prettier": "3.6.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.1"
	},
	"dependencies": {
		"async-wait-until": "^2.0.31",
		"electron-edge-js": "^42.0.0",
		"fast-xml-parser": "^5.3.2"
	}
}
